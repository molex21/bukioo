PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=bukioo
DATABASE_USER=bukioo
DATABASE_PASSWORD=change_me

NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://bukioo:CHANGE_ME@localhost:5432/bukioo?sslmode=disable
# Solo para tests E2E: debe apuntar a una base separada cuyo nombre termine en _test.
DATABASE_URL_TEST=postgres://bukioo:CHANGE_ME@localhost:5432/bukioo_test?sslmode=disable

FRONTEND_URL=http://localhost:5173
TRUST_PROXY_HOPS=0
LOG_LEVEL=info

JWT_ACCESS_SECRET=replace_with_a_random_value_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_value_at_least_32_characters
JWT_EMAIL_VERIFICATION_SECRET=replace_with_another_random_value_at_least_32_characters
TOTP_ENCRYPTION_KEY=replace_with_a_random_value_at_least_32_characters
ONBOARDING_SECRET=replace_with_a_random_onboarding_value_at_least_32_characters
PGBOSS_ENABLED=true
SWAGGER_ENABLED=false
EMAIL_DELIVERY_ENABLED=true
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM_EMAIL=no-reply@your-verified-domain.example
